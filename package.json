{
  "name": "dsh-health-assistant",
  "version": "0.1.2",
  "description": "DSH 插件：健康小助手 —— 定时提醒休息、连续工作劝停、熬夜提醒。完全本地，不联网。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE", "CHANGELOG.md"],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "health",
    "break-reminder",
    "pomodoro",
    "wellbeing"
  ],
  "engines": { "node": ">=18.17" },
  "publishConfig": { "access": "public" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "react": "^18.3.1"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test-all.mjs",
    "prepublishOnly": "node scripts/build.mjs"
  }
}